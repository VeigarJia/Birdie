# Owner key: uses Birdie and manages other people's access at /admin.
# Generate with: openssl rand -base64 32
BIRDIE_ACCESS_KEY=

# Upstash Redis for user keys (set automatically when you connect Upstash in Vercel → Storage).
# Either naming works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
